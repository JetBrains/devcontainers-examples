/*
waitFor
-------

Specifies which lifecycle hook a supporting tool must wait for before it
connects to the container.

Possible values: `onCreateCommand`, `updateContentCommand`, `postCreateCommand`
Default: `updateContentCommand`.

Use `onCreateCommand` or `updateContentCommand` for tasks that have to finish
before the tool attaches, and reserve `postCreateCommand` for work that can
run later in the background.
*/

{
  "name": "Ubuntu",
  image: "ubuntu:latest",

  "onCreateCommand": "sleep 30 && echo onCreateCommand",
  "updateContentCommand": "sleep 30 && echo updateContentCommand",
  "postCreateCommand": "sleep 30 && echo postCreateCommand",
  "waitFor": "postCreateCommand"
}
